generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  OPEN
  COMPLETED
}

model User {
  id                 String @id @default(cuid())
  email              String @unique
  passwordHash       String
  displayName        String
  emailVerifiedAt    DateTime?
  verificationToken  String? @unique
  verificationTokenExpires DateTime?
  resetToken         String? @unique
  resetTokenExpires  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  memberships        GroupMember[]
  assignedTasks      CleaningTask[] @relation("AssignedTasks")
  createdTasks       CleaningTask[] @relation("CreatedTasks")
  completions        TaskCompletion[]
  sessions           Session[]
}

model HouseholdGroup {
  id          String @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
inviteVersion Int @default(1)
  members     GroupMember[]
  tasks       CleaningTask[]
  invitations Invitation[]
}

model GroupMember {
  id        String @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  group     HouseholdGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId])
}

model Invitation {
  id        String @id @default(cuid())
  groupId   String
  codeHash  String @unique
  expiresAt DateTime
  usesLimit Int @default(1)
  uses      Int @default(0)
  createdAt DateTime @default(now())
  group     HouseholdGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model CleaningTask {
  id          String @id @default(cuid())
  groupId     String
  title       String
  description String? @db.Text
  scheduledAt DateTime
  status      TaskStatus @default(OPEN)
  assigneeId  String?
  creatorId   String
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       HouseholdGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignee    User? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)
  completions TaskCompletion[]
  @@index([groupId, scheduledAt])
  @@index([assigneeId, status])
}

model TaskCompletion {
  id          String @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime @default(now())
  task        CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([taskId, userId])
  @@index([userId, completedAt])
}

model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
